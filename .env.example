# ============================================================================
# 1PROMPT SETTER DEMO — environment configuration
# Copy this file to `.env` and fill in the values for the sections you need.
#   cp .env.example .env
# ============================================================================


# ----------------------------------------------------------------------------
# 1) AI PROVIDER SELECTION  (the whole point: swap the brain with ONE line)
# ----------------------------------------------------------------------------
# Set to exactly one of: claude | openai | gemini | groq
# On startup the app validates that the SELECTED provider's key is present and
# fails loudly if it is missing. Keys for the other providers are ignored.
# TIP: groq has the most generous free tier — best for demos.
AI_PROVIDER=claude


# ----------------------------------------------------------------------------
# 2) ANTHROPIC / CLAUDE   (used when AI_PROVIDER=claude)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model id. Default is Claude Sonnet. See https://docs.claude.com/en/docs/about-claude/models
CLAUDE_MODEL=claude-sonnet-5


# ----------------------------------------------------------------------------
# 3) OPENAI   (used when AI_PROVIDER=openai)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# ----------------------------------------------------------------------------
# 4) GOOGLE GEMINI   (used when AI_PROVIDER=gemini)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
# gemini-2.5-flash has free-tier quota; the 2.0-flash free tier is often capped at 0.
GEMINI_MODEL=gemini-2.5-flash


# ----------------------------------------------------------------------------
# 4b) GROQ   (used when AI_PROVIDER=groq)  ← best free-tier limits for demos
# ----------------------------------------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Current model names: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile


# ----------------------------------------------------------------------------
# 5) MESSAGING CHANNEL SELECTOR
# ----------------------------------------------------------------------------
# "twilio" = Twilio WhatsApp (sandbox or approved sender)  [default]
# "cloud"  = Meta WhatsApp Cloud API (branded number, dp + name)
CHANNEL=twilio


# ----------------------------------------------------------------------------
# 5a) TWILIO WHATSAPP   (used when CHANNEL=twilio)
# ----------------------------------------------------------------------------
# From the Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp sandbox number, in E.164 with the whatsapp: prefix.
# The sandbox number is +1 415 523 8886 (same for every account).
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886


# ----------------------------------------------------------------------------
# 5b) META WHATSAPP CLOUD API   (used when CHANNEL=cloud)
# ----------------------------------------------------------------------------
# From developers.facebook.com → your app → WhatsApp → API Setup:
WHATSAPP_TOKEN=                 # access token (use the permanent System-User one)
WHATSAPP_PHONE_NUMBER_ID=       # the sender number's "Phone number ID"
WHATSAPP_BUSINESS_ACCOUNT_ID=   # WABA ID (kept for reference / template mgmt)
# A random word YOU pick; you paste the same value into Meta's Webhook config.
WHATSAPP_VERIFY_TOKEN=samar-demo-123
# The approved opener template (Meta requires a template to START a chat).
# {{1}} = lead name, {{2}} = their interest.
WHATSAPP_OPENER_TEMPLATE=       # e.g. setter_opener
WHATSAPP_OPENER_LANG=en
# Optional: text shown in the log/history for the opener (match your template body).
WHATSAPP_OPENER_TEXT=Hi {{name}}! thanks for reaching out about {{interest}} 👋 mind if I ask you a couple quick questions here?


# ----------------------------------------------------------------------------
# 6) HUMANIZATION LAYER  (mirrors the 1prompt-os setter behavior)
# ----------------------------------------------------------------------------
# Debounce window (ms): when a lead fires several messages in a row, we wait for
# this quiet gap to pass, then answer ALL of them with ONE reply. 8000 = 8s.
# (See NOTES.md for how 1prompt-os batches messages in its Trigger.dev task.)
DEBOUNCE_MS=8000

# Split a longer reply into 2 short sequential WhatsApp messages (true/false).
SPLIT_MESSAGES=true

# Typing/timing model — a human-like delay is added before sending, scaled to
# the reply length so it never feels instant/robotic.
TYPING_MIN_MS=1500          # floor, no reply is faster than this
TYPING_PER_CHAR_MS=35       # extra ms added per character of the reply
TYPING_MAX_MS=9000          # ceiling, so long replies don't stall forever


# ----------------------------------------------------------------------------
# 7) SERVER
# ----------------------------------------------------------------------------
PORT=3000
